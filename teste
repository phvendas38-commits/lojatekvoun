/* ---------------- CARD DE PRODUTO ---------------- */
function ratingHtml(p){
  if(!p.avaliacao || p.avaliacao<=0) return `<span class="rating">Ainda sem avaliações</span>`;
  return `<span class="rating"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3 6.5 7 1-5.2 4.9L18 21l-6-3.6L6 21l1.2-6.6L2 9.5l7-1z"/></svg>${p.avaliacao.toFixed(1)}</span>`;
}
function productCard(p){
  const promo = p.precoPromo && p.precoPromo < p.preco;
  const price = promo ? p.precoPromo : p.preco;
  const inst = Math.max(1, Math.min(10, Math.round(price/60)||1));
  const instVal = price/inst;
  const outOfStock = !p.estoque || p.estoque<=0;
  const isFav = favorites.has(p.id);
  return `
  <div class="pcard" data-id="${p.id}">
    <div class="flags">
      ${promo?'<span class="pill pill-sale">OFERTA</span>':''}
      ${p.bestseller?'<span class="pill pill-best">MAIS VENDIDO</span>':''}
      ${outOfStock?'<span class="pill pill-out">SEM ESTOQUE</span>':''}
    </div>
    <button class="fav-btn ${isFav?'active':''}" data-fav="${p.id}" title="Favoritar">
      <svg viewBox="0 0 24 24" fill="${isFav?'currentColor':'none'}" stroke="currentColor" stroke-width="1.8"><path d="M12 20s-7-4.35-9.5-8.8C1 8 2.4 4.7 5.6 4.1 7.9 3.7 10 5 12 7.5 14 5 16.1 3.7 18.4 4.1 21.6 4.7 23 8 21.5 11.2 19 15.65 12 20 12 20z"/></svg>
    </button>
    <div class="thumb" data-open="${p.id}">${iconFor(p.categoria)}</div>
    <div class="body">
      <span class="cat-tag">${p.categoria[0]}</span>
      <span class="name" data-open="${p.id}">${p.nome}</span>
      ${ratingHtml(p)}
      <div class="price-row">
        ${promo?`<div class="price-old">${money(p.preco)}</div>`:''}
        <div class="price-now">${money(price)}</div>
        <div class="price-inst">ou ${inst}x de ${money(instVal)} sem juros</div>
        <div class="price-pix">Pagando com PIX</div>
      </div>
      <button class="add-btn" data-add="${p.id}" ${outOfStock?'disabled':''}>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="9" cy="21" r="1.4"/><circle cx="18" cy="21" r="1.4"/><path d="M2.5 3h2.2l2.4 12.3a2 2 0 0 0 2 1.6h8.2a2 2 0 0 0 2-1.6L21 7H6"/></svg>
        ${outOfStock?'Avise-me quando chegar':'Adicionar ao carrinho'}
      </button>
    </div>
  </div>`;
}
function bindProductCardEvents(container){
  container.querySelectorAll('[data-open]').forEach(el=>{
    el.addEventListener('click', ()=>{ openProduct(parseInt(el.dataset.open)); });
  });
  container.querySelectorAll('[data-add]').forEach(el=>{
    el.addEventListener('click', (e)=>{
      e.stopPropagation();
      const id = parseInt(el.dataset.add);
      const p = PRODUCTS.find(x=>x.id===id);
      if(!p.estoque || p.estoque<=0){ toast('Você será avisado quando este produto chegar ao estoque.'); return; }
      addToCart(id,1); toast('Produto adicionado ao carrinho');
    });
  });
  container.querySelectorAll('[data-fav]').forEach(el=>{
    el.addEventListener('click', (e)=>{
      e.stopPropagation();
      const id = parseInt(el.dataset.fav);
      if(favorites.has(id)) favorites.delete(id); else favorites.add(id);
      updateFavCount();
      renderAll();
    });
  });
}
function updateFavCount(){
  const el = document.getElementById('favCount');
  el.textContent = favorites.size;
  el.style.display = favorites.size>0 ? 'flex':'none';
}

