function renderProdTable(){
  const body = document.getElementById('prodTableBody');
  body.innerHTML = PRODUCTS.map(p=>`
    <tr data-row="${p.id}">
      <td><input data-f="nome" value="${p.nome}" style="min-width:220px"></td>
      <td><input data-f="categoria" value="${p.categoria.join(', ')}" style="min-width:140px"></td>
      <td><input data-f="preco" type="number" step="0.01" value="${p.preco}" style="width:90px"></td>
      <td><input data-f="precoPromo" type="number" step="0.01" value="${p.precoPromo||''}" placeholder="—" style="width:90px"></td>
      <td><input data-f="estoque" type="number" value="${p.estoque}" style="width:70px"></td>
      <td><input data-f="bestseller" type="checkbox" ${p.bestseller?'checked':''}></td>
      <td><button class="btn btn-sm btn-ghost" data-save="${p.id}">Salvar</button> <button class="btn btn-sm" style="color:var(--sale)" data-del="${p.id}">Excluir</button></td>
    </tr>`).join('');
  body.querySelectorAll('[data-save]').forEach(btn=>{
    btn.addEventListener('click', ()=>{
      const row = btn.closest('tr'); const id = parseInt(btn.dataset.save);
      const p = PRODUCTS.find(x=>x.id===id);
      p.nome = row.querySelector('[data-f=nome]').value;
      p.categoria = row.querySelector('[data-f=categoria]').value.split(',').map(s=>s.trim()).filter(Boolean);
      p.preco = parseFloat(row.querySelector('[data-f=preco]').value)||0;
      const promo = row.querySelector('[data-f=precoPromo]').value;
      p.precoPromo = promo? parseFloat(promo) : null;
      p.estoque = parseInt(row.querySelector('[data-f=estoque]').value)||0;
      p.bestseller = row.querySelector('[data-f=bestseller]').checked;
      toast('Produto atualizado'); renderAll();
    });
  });
  body.querySelectorAll('[data-del]').forEach(btn=>{
    btn.addEventListener('click', ()=>{
      PRODUCTS = PRODUCTS.filter(p=>p.id!==parseInt(btn.dataset.del));
      renderProdTable(); renderAll(); toast('Produto excluído');
    });
  });
}
function renderCatList(){
  document.getElementById('catList').innerHTML = CATEGORIES.map(c=>`<span class="pill" style="background:var(--pale);color:var(--navy);padding:8px 12px;border-radius:8px">${c}</span>`).join('');
}
function renderBrandListAdmin(){
