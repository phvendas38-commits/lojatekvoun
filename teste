/* ---------------- NAVEGAÇÃO ---------------- */
function navTo(page){
  document.querySelectorAll('.page').forEach(p=>p.classList.add('hide'));
  const target = document.getElementById('page-'+page);
  if(target) target.classList.remove('hide');
  document.querySelectorAll('.nav-link').forEach(a=>a.classList.remove('active'));
  window.scrollTo({top:0,behavior:'instant' in window ? 'instant':'auto'});
  document.getElementById('mainNav').classList.remove('mobile-open');
  document.getElementById('searchWrap').classList.remove('mobile-open');
}

document.addEventListener('click', (e)=>{
  const navEl = e.target.closest('[data-nav]');
  if(navEl){
    e.preventDefault();
    const page = navEl.dataset.nav;
    if(page==='shop'){
      if(navEl.dataset.sort) shopFilter.sort = navEl.dataset.sort==='ofertas'?'relevancia':navEl.dataset.sort;
      if(navEl.dataset.sort==='ofertas'){ shopFilter.onlyOffers = true; } else { shopFilter.onlyOffers=false; }
      if(navEl.dataset.sort==='mais-vendidos'){ shopFilter.onlyBest = true; } else if(navEl.dataset.sort!=='ofertas'){ shopFilter.onlyBest=false; }
      renderShop();
    }
    if(page==='account'){
      renderAccount();
      if(navEl.dataset.tab && currentUser) setAcctTab(navEl.dataset.tab);
    }
    if(page==='cart') renderCart();
    if(page==='checkout') renderCheckout();
    if(page==='admin') {} // gate handled separately
    if(page==='contato') renderContato();
    navTo(page);
    if(navEl.dataset.scroll){
      setTimeout(()=>document.getElementById(navEl.dataset.scroll)?.scrollIntoView({behavior:'smooth'}),50);
    }
  }
});

