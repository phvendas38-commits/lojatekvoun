  if(shopFilter.q) list = list.filter(p=>p.nome.toLowerCase().includes(shopFilter.q.toLowerCase()));
  if(shopFilter.onlyOffers) list = list.filter(p=>p.precoPromo && p.precoPromo<p.preco);
  if(shopFilter.onlyBest) list = list.filter(p=>p.bestseller);
  const sort = document.getElementById('sortSelect').value = shopFilter.sort;
  if(sort==='menor-preco') list.sort((a,b)=>(a.precoPromo||a.preco)-(b.precoPromo||b.preco));
  if(sort==='maior-preco') list.sort((a,b)=>(b.precoPromo||b.preco)-(a.precoPromo||a.preco));
  if(sort==='novos') list.sort((a,b)=>b.id-a.id);

  document.getElementById('shopCount').textContent = `${list.length} produto${list.length!==1?'s':''} encontrado${list.length!==1?'s':''}`;
  const chips = document.getElementById('filterChips');
  chips.innerHTML = CATEGORIES.map(c=>`<button class="btn btn-sm ${shopFilter.categoria===c?'btn-primary':'btn-ghost'}" style="margin:0 8px 8px 0" data-catchip="${c}">${c}</button>`).join('')+
