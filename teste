function renderShop(){
  document.getElementById('shopTitle').textContent = shopFilter.categoria ? shopFilter.categoria : (shopFilter.q ? `Resultados para "${shopFilter.q}"` : 'Todos os produtos');
  let list = [...PRODUCTS];
