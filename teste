<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>TEKVOUN ELETRÔNICOS — Tecnologia, Inovação, Confiança</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
:root{
  --blue:#1858F4;
  --blue-2:#0040D6;
  --navy:#0B1F52;
  --navy-2:#081533;
  --ink:#0A0D14;
  --white:#FFFFFF;
  --pale:#EEF3FF;
  --pale-2:#F6F8FD;
  --line:#DFE6F5;
  --muted:#5B6478;
  --cyan:#31D3F2;
  --sale:#E0402E;
  --ok:#1D9E63;
  --radius:14px;
  --radius-sm:9px;
  --shadow:0 6px 24px rgba(11,31,82,0.08);
  --shadow-lg:0 18px 48px rgba(11,31,82,0.16);
}
*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
body{
  font-family:'Inter',system-ui,sans-serif;
  color:var(--ink);
  background:var(--white);
  -webkit-font-smoothing:antialiased;
  line-height:1.5;
}
h1,h2,h3,h4,.disp{font-family:'Space Grotesk',sans-serif}
img{max-width:100%;display:block}
a{color:inherit;text-decoration:none}
button{font-family:inherit;cursor:pointer;border:none;background:none;color:inherit}
input,select{font-family:inherit;font-size:14px}
.container{max-width:1240px;margin:0 auto;padding:0 24px}
.hide{display:none !important}
.badge-count{
  position:absolute;top:-6px;right:-8px;background:var(--blue);color:#fff;
  font-size:10px;font-weight:700;min-width:18px;height:18px;border-radius:9px;
  display:flex;align-items:center;justify-content:center;padding:0 4px;
}
.btn{
  display:inline-flex;align-items:center;justify-content:center;gap:8px;
  padding:13px 24px;border-radius:10px;font-weight:600;font-size:14.5px;
  transition:transform .15s ease, box-shadow .15s ease, background .15s ease;
  white-space:nowrap;
}
.btn:active{transform:scale(.97)}
.btn-primary{background:var(--blue);color:#fff;box-shadow:0 8px 20px rgba(24,88,244,.28)}
.btn-primary:hover{background:var(--blue-2)}
.btn-outline{background:transparent;color:#fff;border:1.5px solid rgba(255,255,255,.55)}
.btn-outline:hover{background:rgba(255,255,255,.12)}
.btn-dark-outline{background:transparent;color:var(--navy);border:1.5px solid var(--line)}
.btn-dark-outline:hover{border-color:var(--blue);color:var(--blue)}
.btn-block{width:100%}
.btn-sm{padding:9px 14px;font-size:13px;border-radius:8px}
.btn-ghost{background:var(--pale);color:var(--navy)}
.btn-ghost:hover{background:#e3ebfd}
.btn:disabled{opacity:.5;cursor:not-allowed}

/* ---------- Top bar ---------- */
.topbar{background:var(--navy-2);color:#c9d5f4;font-size:12.5px;padding:7px 0}
.topbar .container{display:flex;justify-content:space-between;align-items:center;gap:16px;flex-wrap:wrap}
.topbar-links{display:flex;gap:18px;flex-wrap:wrap}
.topbar-links span{opacity:.9}

/* ---------- Header ---------- */
header.site{position:sticky;top:0;z-index:60;background:#fff;box-shadow:0 1px 0 var(--line)}
.header-main{display:flex;align-items:center;gap:24px;padding:16px 0}
.logo{display:flex;align-items:center;gap:10px;flex-shrink:0}
.logo-mark{
  width:42px;height:42px;border-radius:11px;background:linear-gradient(150deg,var(--blue),var(--navy));
  display:flex;align-items:center;justify-content:center;flex-shrink:0;
}
.logo-mark svg{width:24px;height:24px}
.logo-text{display:flex;flex-direction:column;line-height:1.15}
.logo-text b{font-family:'Space Grotesk';font-weight:700;font-size:19px;letter-spacing:.2px;color:var(--navy)}
.logo-text small{font-size:9.5px;letter-spacing:1.4px;color:var(--muted);font-weight:600}
.search-wrap{flex:1;position:relative;max-width:640px}
.search-wrap input{
  width:100%;padding:12px 46px 12px 16px;border:1.5px solid var(--line);border-radius:10px;
  background:var(--pale-2);font-size:14px;
}
.search-wrap input:focus{outline:none;border-color:var(--blue);background:#fff}
.search-wrap button{position:absolute;right:6px;top:50%;transform:translateY(-50%);width:34px;height:34px;border-radius:8px;display:flex;align-items:center;justify-content:center;color:var(--muted)}
.search-wrap button:hover{color:var(--blue)}
.header-icons{display:flex;align-items:center;gap:6px;flex-shrink:0}
.icon-btn{position:relative;width:44px;height:44px;border-radius:10px;display:flex;align-items:center;justify-content:center;color:var(--navy)}
.icon-btn:hover{background:var(--pale)}
.icon-btn svg{width:22px;height:22px}
.hamburger{display:none;width:44px;height:44px;align-items:center;justify-content:center;border-radius:10px}
.hamburger svg{width:24px;height:24px}

nav.main-nav{border-top:1px solid var(--line);background:#fff}
nav.main-nav .container{display:flex;gap:2px}
nav.main-nav a{padding:13px 15px;font-size:14px;font-weight:600;color:var(--navy);border-bottom:2.5px solid transparent;white-space:nowrap}
nav.main-nav a:hover, nav.main-nav a.active{color:var(--blue);border-color:var(--blue)}

/* ---------- Hero ---------- */
.hero{
  position:relative;overflow:hidden;
  background:radial-gradient(1200px 500px at 15% -10%, #1E63FF 0%, transparent 60%), linear-gradient(120deg,var(--navy) 0%, var(--navy-2) 100%);
  color:#fff;
}
.hero .grid-overlay{position:absolute;inset:0;opacity:.16;pointer-events:none;
  background-image:linear-gradient(rgba(255,255,255,.5) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.5) 1px, transparent 1px);
  background-size:44px 44px; mask-image:linear-gradient(to bottom, black, transparent 85%);
}
.hero-inner{position:relative;display:grid;grid-template-columns:1.1fr .9fr;gap:40px;align-items:center;padding:64px 0 56px}
.eyebrow{font-size:12.5px;font-weight:700;letter-spacing:2px;color:var(--cyan);margin-bottom:16px}
.hero h1{font-size:44px;line-height:1.08;font-weight:700;max-width:560px;letter-spacing:-.5px}
.hero p.sub{margin-top:18px;font-size:16.5px;color:#c9d5f4;max-width:460px}
.hero-ctas{display:flex;gap:12px;margin-top:30px;flex-wrap:wrap}
.trust-row{display:flex;gap:22px;margin-top:34px;flex-wrap:wrap}
.trust-row div{display:flex;align-items:center;gap:8px;font-size:13px;color:#dbe4fb;font-weight:500}
.trust-row svg{width:18px;height:18px;color:var(--cyan);flex-shrink:0}
.hero-art{position:relative;height:380px}
.float-card{
  position:absolute;background:rgba(255,255,255,.08);backdrop-filter:blur(6px);
  border:1px solid rgba(255,255,255,.18);border-radius:16px;padding:16px 18px;
  display:flex;align-items:center;gap:12px;box-shadow:0 20px 40px rgba(0,0,0,.25);
}
.float-card svg{width:26px;height:26px;color:var(--cyan)}
.float-card span{font-size:13px;font-weight:600;color:#fff}
.float-card.c1{top:2%;left:6%;animation:float1 6s ease-in-out infinite}
.float-card.c2{top:34%;right:2%;animation:float2 7s ease-in-out infinite}
.float-card.c3{bottom:10%;left:16%;animation:float1 6.5s ease-in-out infinite reverse}
.float-card.c4{bottom:32%;right:26%;animation:float2 5.5s ease-in-out infinite reverse}
.hero-orb{position:absolute;width:260px;height:260px;border-radius:50%;left:50%;top:50%;transform:translate(-50%,-50%);
  background:conic-gradient(from 90deg, var(--blue), var(--cyan), var(--blue));filter:blur(2px);opacity:.35}
@keyframes float1{0%,100%{transform:translateY(0)}50%{transform:translateY(-14px)}}
@keyframes float2{0%,100%{transform:translateY(0)}50%{transform:translateY(12px)}}

/* ---------- Benefits ---------- */
.benefits{background:#fff;border-bottom:1px solid var(--line)}
.benefits .container{display:grid;grid-template-columns:repeat(4,1fr);gap:0;padding:28px 24px}
.benefit-item{display:flex;gap:12px;align-items:flex-start;padding:0 16px;border-left:1px solid var(--line)}
.benefit-item:first-child{border-left:none;padding-left:0}
.benefit-item svg{width:26px;height:26px;color:var(--blue);flex-shrink:0;margin-top:2px}
.benefit-item b{display:block;font-size:13.5px;font-weight:700;margin-bottom:2px}
.benefit-item p{font-size:12.5px;color:var(--muted)}

/* ---------- Sections generic ---------- */
.section{padding:56px 0}
.section-head{display:flex;justify-content:space-between;align-items:flex-end;margin-bottom:28px;gap:20px}
.section-head h2{font-size:27px;font-weight:700;letter-spacing:-.3px}
.section-head p{color:var(--muted);font-size:14px;margin-top:6px}
.section.alt{background:var(--pale-2)}

/* ---------- Categories ---------- */
.cat-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:16px}
.cat-card{
  background:#fff;border:1px solid var(--line);border-radius:var(--radius);padding:22px 16px;text-align:center;
  transition:box-shadow .18s, transform .18s, border-color .18s;
}
.cat-card:hover{box-shadow:var(--shadow);transform:translateY(-3px);border-color:transparent}
.cat-card .ic{width:52px;height:52px;border-radius:14px;background:var(--pale);display:flex;align-items:center;justify-content:center;margin:0 auto 12px}
.cat-card .ic svg{width:26px;height:26px;color:var(--blue)}
.cat-card b{font-size:13.5px;font-weight:600}

/* ---------- Product cards ---------- */
.prod-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:18px}
.prod-grid.cols-3{grid-template-columns:repeat(3,1fr)}
.pcard{
  background:#fff;border:1px solid var(--line);border-radius:var(--radius);overflow:hidden;
  display:flex;flex-direction:column;transition:box-shadow .18s, transform .18s;position:relative;
}
.pcard:hover{box-shadow:var(--shadow-lg);transform:translateY(-4px)}
.pcard .thumb{
  aspect-ratio:1/1;background:linear-gradient(150deg,var(--pale),#fff);display:flex;align-items:center;justify-content:center;
  position:relative;cursor:pointer;border-bottom:1px solid var(--line);
}
.pcard .thumb svg{width:64px;height:64px;color:var(--blue);opacity:.85}
.pcard .fav-btn{position:absolute;top:10px;right:10px;width:34px;height:34px;border-radius:50%;background:#fff;box-shadow:0 2px 8px rgba(0,0,0,.12);display:flex;align-items:center;justify-content:center;z-index:2}
.pcard .fav-btn svg{width:17px;height:17px;color:var(--navy)}
.pcard .fav-btn.active svg{color:var(--sale);fill:var(--sale)}
.pcard .flags{position:absolute;top:10px;left:10px;display:flex;flex-direction:column;gap:6px;z-index:2}
.pill{font-size:10.5px;font-weight:700;padding:4px 9px;border-radius:6px;letter-spacing:.3px}
.pill-sale{background:var(--sale);color:#fff}
.pill-out{background:var(--navy);color:#fff}
.pill-best{background:var(--cyan);color:var(--navy)}
.pcard .body{padding:14px 15px 16px;display:flex;flex-direction:column;gap:8px;flex:1}
.pcard .cat-tag{font-size:10.5px;color:var(--blue);font-weight:700;letter-spacing:.3px;text-transform:uppercase}
.pcard .name{font-size:13.5px;font-weight:600;line-height:1.35;cursor:pointer;min-height:36px}
.pcard .name:hover{color:var(--blue)}
.pcard .rating{font-size:12px;color:var(--muted);display:flex;align-items:center;gap:5px}
.pcard .rating svg{width:13px;height:13px;color:#F5A623}
.pcard .price-row{margin-top:auto}
.price-old{font-size:12px;color:var(--muted);text-decoration:line-through}
.price-now{font-size:19px;font-weight:700;color:var(--navy)}
.price-inst{font-size:11.5px;color:var(--muted);margin-top:2px}
.price-pix{font-size:11.5px;color:var(--ok);font-weight:600;margin-top:1px}
.pcard .add-btn{margin-top:10px;width:100%;padding:10px;border-radius:9px;background:var(--pale);color:var(--blue);font-weight:700;font-size:12.5px;display:flex;align-items:center;justify-content:center;gap:6px}
.pcard .add-btn:hover{background:var(--blue);color:#fff}
.pcard .add-btn:disabled{background:var(--pale-2);color:var(--muted)}
.pcard .add-btn svg{width:15px;height:15px}

.empty-state{
  border:1.5px dashed var(--line);border-radius:var(--radius);padding:40px 24px;text-align:center;color:var(--muted);
  background:#fff;
}
.empty-state svg{width:34px;height:34px;color:var(--line);margin:0 auto 10px}
.empty-state b{display:block;color:var(--navy);font-size:14.5px;margin-bottom:4px}
.empty-state p{font-size:13px}

/* ---------- Offers banner ---------- */
.offers-banner{
  border-radius:20px;padding:34px 32px;background:linear-gradient(120deg,var(--navy),var(--blue-2));color:#fff;
  display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:20px;margin-bottom:30px;
}
.offers-banner h3{font-size:24px;font-weight:700}
.offers-banner p{color:#cfdaf7;font-size:13.5px;margin-top:6px}
.countdown{display:flex;gap:10px}
.countdown .cbox{background:rgba(255,255,255,.12);border:1px solid rgba(255,255,255,.2);border-radius:10px;padding:10px 14px;text-align:center;min-width:58px}
.countdown .cbox b{display:block;font-size:20px;font-family:'Space Grotesk'}
.countdown .cbox span{font-size:9.5px;color:#cfdaf7;letter-spacing:.5px}

/* ---------- Brands ---------- */
.brand-grid{display:grid;grid-template-columns:repeat(6,1fr);gap:14px}
.brand-chip{background:#fff;border:1px solid var(--line);border-radius:var(--radius-sm);padding:20px 10px;text-align:center;font-weight:700;color:var(--navy);font-size:13.5px;letter-spacing:.3px}

/* ---------- WhatsApp float ---------- */
.wa-float{
  position:fixed;bottom:22px;right:22px;z-index:70;width:58px;height:58px;border-radius:50%;
  background:#25D366;box-shadow:0 10px 26px rgba(37,211,102,.45);display:flex;align-items:center;justify-content:center;
}
.wa-float svg{width:28px;height:28px;color:#fff}
.wa-float:hover{transform:scale(1.06)}

/* ---------- Footer ---------- */
footer.site{background:var(--navy-2);color:#c9d5f4}
.foot-top{padding:52px 0 34px;display:grid;grid-template-columns:1.4fr repeat(4,1fr);gap:28px}
.foot-brand .logo-text b{color:#fff}
.foot-brand p{font-size:13px;color:#9fb1e0;margin-top:14px;max-width:280px;line-height:1.6}
.foot-col h4{font-size:12.5px;color:#fff;font-weight:700;letter-spacing:.6px;margin-bottom:14px;text-transform:uppercase}
.foot-col a, .foot-col span{display:block;font-size:13.5px;color:#a8b8e0;margin-bottom:10px}
.foot-col a:hover{color:#fff}
.pay-icons{display:flex;gap:8px;flex-wrap:wrap;margin-top:6px}
.pay-icons span{background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.14);padding:6px 10px;border-radius:7px;font-size:11px;color:#dbe4fb;font-weight:600}
.social-row{display:flex;gap:10px;margin-top:16px}
.social-row a{width:36px;height:36px;border-radius:9px;background:rgba(255,255,255,.08);display:flex;align-items:center;justify-content:center}
.social-row svg{width:17px;height:17px;color:#fff}
.foot-bottom{border-top:1px solid rgba(255,255,255,.1);padding:20px 0;display:flex;justify-content:space-between;align-items:center;font-size:12.5px;color:#8093c2;flex-wrap:wrap;gap:10px}
.foot-bottom a{color:#8093c2}
.foot-bottom a:hover{color:#fff}

/* ---------- Breadcrumb ---------- */
.breadcrumb{font-size:12.5px;color:var(--muted);padding:18px 0}
.breadcrumb a:hover{color:var(--blue)}
.breadcrumb span{margin:0 6px}

/* ---------- Product Detail ---------- */
.pd-grid{display:grid;grid-template-columns:.95fr 1.05fr;gap:44px;padding-bottom:56px}
.pd-gallery .main-img{
  aspect-ratio:1/1;border-radius:var(--radius);background:linear-gradient(150deg,var(--pale),#fff);
  border:1px solid var(--line);display:flex;align-items:center;justify-content:center;
}
.pd-gallery .main-img svg{width:140px;height:140px;color:var(--blue);opacity:.85}
.pd-thumbs{display:flex;gap:10px;margin-top:12px}
.pd-thumbs div{width:64px;height:64px;border-radius:9px;border:1.5px solid var(--line);background:var(--pale-2);display:flex;align-items:center;justify-content:center}
.pd-thumbs div svg{width:26px;height:26px;color:var(--blue)}
.pd-info h1{font-size:24px;font-weight:700;line-height:1.3;letter-spacing:-.2px}
.pd-meta{display:flex;gap:16px;align-items:center;margin-top:10px;font-size:13px;color:var(--muted);flex-wrap:wrap}
.pd-price-block{margin-top:20px;padding:20px;background:var(--pale-2);border-radius:var(--radius)}
.pd-price-block .old{font-size:14px;color:var(--muted);text-decoration:line-through}
.pd-price-block .now{font-size:32px;font-weight:700;font-family:'Space Grotesk';color:var(--navy)}
.pd-price-block .inst{font-size:13.5px;color:var(--muted);margin-top:4px}
.pd-price-block .pix{font-size:13.5px;color:var(--ok);font-weight:600;margin-top:6px;display:flex;align-items:center;gap:6px}
.stock-row{margin-top:16px;display:flex;align-items:center;gap:8px;font-size:13.5px;font-weight:600}
.dot{width:8px;height:8px;border-radius:50%}
.dot.in{background:var(--ok)}.dot.out{background:var(--sale)}
.qty-row{display:flex;align-items:center;gap:14px;margin-top:18px}
.qty-ctrl{display:flex;align-items:center;border:1.5px solid var(--line);border-radius:9px;overflow:hidden}
.qty-ctrl button{width:36px;height:38px;font-size:16px;font-weight:700;color:var(--navy)}
.qty-ctrl button:hover{background:var(--pale)}
.qty-ctrl input{width:44px;text-align:center;border:none;border-left:1px solid var(--line);border-right:1px solid var(--line);height:38px}
.pd-actions{display:flex;gap:12px;margin-top:20px;flex-wrap:wrap}
.pd-actions .btn{flex:1;min-width:160px}
.tabs{display:flex;gap:2px;border-bottom:1.5px solid var(--line);margin-top:40px}
.tab-btn{padding:12px 18px;font-size:14px;font-weight:600;color:var(--muted);border-bottom:2.5px solid transparent;margin-bottom:-1.5px}
.tab-btn.active{color:var(--blue);border-color:var(--blue)}
.tab-panel{padding:22px 0;font-size:14px;color:var(--ink);line-height:1.75}
.tab-panel table{width:100%;border-collapse:collapse}
.tab-panel td{padding:9px 0;border-bottom:1px solid var(--line);font-size:13.5px}
.tab-panel td:first-child{color:var(--muted);width:220px}

/* ---------- Cart ---------- */
.cart-layout{display:grid;grid-template-columns:1fr .42fr;gap:32px;padding-bottom:60px}
.cart-item{display:flex;gap:16px;align-items:center;padding:18px 0;border-bottom:1px solid var(--line)}
.cart-item .th{width:78px;height:78px;border-radius:10px;background:var(--pale);display:flex;align-items:center;justify-content:center;flex-shrink:0}
.cart-item .th svg{width:34px;height:34px;color:var(--blue)}
.cart-item .info{flex:1;min-width:0}
.cart-item .info b{font-size:13.5px;font-weight:600;display:block}
.cart-item .info .cat{font-size:11.5px;color:var(--muted);margin-top:3px}
.cart-item .price{font-weight:700;font-size:14.5px;min-width:90px;text-align:right}
.remove-x{color:var(--muted);font-size:12px;margin-top:6px;font-weight:600}
.remove-x:hover{color:var(--sale)}
.summary-card{background:var(--pale-2);border-radius:var(--radius);padding:24px;position:sticky;top:100px;height:fit-content}
.summary-card h3{font-size:16px;margin-bottom:16px}
.summary-row{display:flex;justify-content:space-between;font-size:13.5px;margin-bottom:10px;color:var(--muted)}
.summary-row b{color:var(--ink)}
.summary-total{display:flex;justify-content:space-between;font-size:17px;font-weight:700;margin-top:14px;padding-top:14px;border-top:1.5px solid var(--line)}
.coupon-row{display:flex;gap:8px;margin:14px 0}
.coupon-row input{flex:1;padding:10px 12px;border:1.5px solid var(--line);border-radius:8px}

/* ---------- Checkout ---------- */
.checkout-layout{display:grid;grid-template-columns:1fr .4fr;gap:32px;padding-bottom:60px}
.co-step{background:#fff;border:1px solid var(--line);border-radius:var(--radius);padding:24px;margin-bottom:18px}
.co-step h3{font-size:15.5px;display:flex;align-items:center;gap:10px;margin-bottom:18px}
.co-step h3 .num{width:24px;height:24px;border-radius:50%;background:var(--blue);color:#fff;font-size:12px;display:flex;align-items:center;justify-content:center;font-weight:700}
.form-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:14px}
.field{display:flex;flex-direction:column;gap:6px}
.field label{font-size:12px;font-weight:600;color:var(--muted)}
.field input,.field select{padding:11px 12px;border:1.5px solid var(--line);border-radius:8px;font-size:13.5px}
.field input:focus,.field select:focus{outline:none;border-color:var(--blue)}
.span2{grid-column:span 2}.span4{grid-column:span 4}.span3{grid-column:span 3}.span1{grid-column:span 1}
.pay-tabs{display:flex;gap:8px;margin-bottom:18px;flex-wrap:wrap}
.pay-tab{flex:1;min-width:110px;padding:12px;border:1.5px solid var(--line);border-radius:9px;text-align:center;font-size:13px;font-weight:600;display:flex;flex-direction:column;align-items:center;gap:6px}
.pay-tab svg{width:20px;height:20px}
.pay-tab.active{border-color:var(--blue);background:var(--pale);color:var(--blue)}
.pay-panel{padding-top:6px}
.pix-box{text-align:center;padding:20px;background:var(--pale-2);border-radius:var(--radius)}
.qr-mock{width:170px;height:170px;margin:0 auto 14px;border-radius:10px;background:
  repeating-linear-gradient(45deg,#0A0D14 0 6px, #fff 6px 12px),
  repeating-linear-gradient(-45deg,#0A0D14 0 6px, transparent 6px 12px);
  background-blend-mode:multiply;border:6px solid #fff;box-shadow:0 0 0 1.5px var(--line)}
.code-copy{display:flex;gap:8px;margin-top:12px}
.code-copy input{flex:1;padding:10px;border:1.5px solid var(--line);border-radius:8px;font-size:12px;color:var(--muted);background:#fff}
.notice{font-size:12px;color:var(--muted);background:var(--pale-2);border-radius:8px;padding:10px 12px;margin-top:14px;line-height:1.5}
.notice.warn{background:#FFF4E9;color:#8A5A1E}
.installment-select{margin-top:10px}

/* ---------- Account ---------- */
.acct-layout{display:grid;grid-template-columns:.3fr 1fr;gap:28px;padding-bottom:60px}
.acct-nav{display:flex;flex-direction:column;gap:4px;background:#fff;border:1px solid var(--line);border-radius:var(--radius);padding:10px;height:fit-content}
.acct-nav button{padding:11px 14px;border-radius:9px;font-size:13.5px;font-weight:600;text-align:left;color:var(--navy)}
.acct-nav button:hover{background:var(--pale)}
.acct-nav button.active{background:var(--blue);color:#fff}
.auth-card{max-width:420px;margin:40px auto;background:#fff;border:1px solid var(--line);border-radius:var(--radius);padding:32px}
.auth-card h2{font-size:22px;margin-bottom:6px}
.auth-card p.sub2{color:var(--muted);font-size:13.5px;margin-bottom:22px}
.auth-toggle{display:flex;gap:8px;margin-top:18px;font-size:13px;color:var(--muted)}
.auth-toggle b{color:var(--blue);cursor:pointer}
.field-stack{display:flex;flex-direction:column;gap:14px}

/* ---------- Admin ---------- */
.admin-shell{display:grid;grid-template-columns:230px 1fr;min-height:70vh}
.admin-side{background:var(--navy-2);color:#c9d5f4;padding:24px 14px}
.admin-side button{width:100%;text-align:left;padding:11px 14px;border-radius:9px;font-size:13.5px;font-weight:600;margin-bottom:4px;color:#c9d5f4}
.admin-side button.active,.admin-side button:hover{background:rgba(255,255,255,.1);color:#fff}
.admin-main{padding:28px 32px;background:var(--pale-2)}
.admin-top{display:flex;justify-content:space-between;align-items:center;margin-bottom:22px}
.admin-top h2{font-size:21px}
.admin-card{background:#fff;border:1px solid var(--line);border-radius:var(--radius);padding:20px;margin-bottom:16px}
.admin-table{width:100%;border-collapse:collapse}
.admin-table th{text-align:left;font-size:11.5px;text-transform:uppercase;letter-spacing:.4px;color:var(--muted);padding:8px 10px;border-bottom:1.5px solid var(--line)}
.admin-table td{padding:10px;border-bottom:1px solid var(--line);font-size:13px;vertical-align:middle}
.admin-table input,.admin-table select{padding:7px 8px;border:1.5px solid var(--line);border-radius:7px;font-size:12.5px;width:100%}
.mini-toggle{display:inline-flex;align-items:center;gap:6px;font-size:12px;font-weight:600}
.kpi-row{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;margin-bottom:20px}
.kpi{background:#fff;border:1px solid var(--line);border-radius:var(--radius);padding:18px}
.kpi span{font-size:12px;color:var(--muted);font-weight:600}
.kpi b{display:block;font-size:24px;font-family:'Space Grotesk';margin-top:6px}
.gate{max-width:380px;margin:60px auto;text-align:center}
.gate .icon{width:56px;height:56px;background:var(--pale);border-radius:14px;display:flex;align-items:center;justify-content:center;margin:0 auto 16px}
.gate .icon svg{width:28px;height:28px;color:var(--blue)}

.toast{
  position:fixed;bottom:26px;left:50%;transform:translateX(-50%) translateY(20px);
  background:var(--navy);color:#fff;padding:14px 22px;border-radius:10px;font-size:13.5px;font-weight:600;
  box-shadow:var(--shadow-lg);z-index:200;opacity:0;pointer-events:none;transition:all .25s ease;display:flex;align-items:center;gap:10px;
}
.toast.show{opacity:1;transform:translateX(-50%) translateY(0)}
.toast svg{width:18px;height:18px;color:var(--cyan)}

/* ---------- Responsive ---------- */
@media (max-width:980px){
  .hero-inner{grid-template-columns:1fr;padding:40px 0}
  .hero-art{display:none}
  .hero h1{font-size:32px}
  .cat-grid{grid-template-columns:repeat(3,1fr)}
  .prod-grid{grid-template-columns:repeat(2,1fr)}
  .prod-grid.cols-3{grid-template-columns:repeat(2,1fr)}
  .benefits .container{grid-template-columns:repeat(2,1fr);gap:18px}
  .benefit-item{border-left:none;padding-left:0}
  .foot-top{grid-template-columns:repeat(2,1fr)}
  .pd-grid{grid-template-columns:1fr;gap:26px}
  .cart-layout,.checkout-layout,.acct-layout{grid-template-columns:1fr}
  .form-grid{grid-template-columns:repeat(2,1fr)}
  .span2,.span3,.span4{grid-column:span 2}
  .admin-shell{grid-template-columns:1fr}
  .admin-side{display:flex;overflow-x:auto;gap:6px;padding:14px}
  .admin-side button{white-space:nowrap;margin-bottom:0}
  .kpi-row{grid-template-columns:repeat(2,1fr)}
  .brand-grid{grid-template-columns:repeat(3,1fr)}
}
@media (max-width:640px){
  .topbar{display:none}
  nav.main-nav{display:none}
  nav.main-nav.mobile-open{display:block}
  nav.main-nav.mobile-open .container{flex-direction:column;padding:8px 20px 14px}
  .search-wrap{display:none}
  .search-wrap.mobile-open{display:block;order:3;flex-basis:100%;max-width:none;margin-top:10px}
  .header-main{flex-wrap:wrap}
  .hamburger{display:flex}
  .logo-text b{font-size:16px}
  .cat-grid{grid-template-columns:repeat(2,1fr)}
  .prod-grid,.prod-grid.cols-3{grid-template-columns:repeat(2,1fr)}
  .brand-grid{grid-template-columns:repeat(2,1fr)}
  .offers-banner{flex-direction:column;align-items:flex-start}
  .hero h1{font-size:27px}
  .btn{padding:14px 20px;font-size:14px}
  .section{padding:38px 0}
  .foot-top{grid-template-columns:1fr;padding:38px 0 20px}
  .wa-float{width:52px;height:52px;bottom:16px;right:16px}
}
</style>
</head>
