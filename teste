function startCountdown(){
  function tick(){
    const box = document.getElementById('countdownBox');
    if(!box) return;
    const diff = new Date(OFFER_END) - new Date();
    if(diff<=0){ box.innerHTML = '<div class="cbox"><b>Encerrado</b></div>'; return; }
    const d = Math.floor(diff/86400000), h=Math.floor(diff/3600000)%24, m=Math.floor(diff/60000)%60, s=Math.floor(diff/1000)%60;
    box.innerHTML = `<div class="cbox"><b>${d}</b><span>DIAS</span></div><div class="cbox"><b>${String(h).padStart(2,'0')}</b><span>HORAS</span></div><div class="cbox"><b>${String(m).padStart(2,'0')}</b><span>MIN</span></div><div class="cbox"><b>${String(s).padStart(2,'0')}</b><span>SEG</span></div>`;
  }
  tick();
  clearInterval(window._cdInterval);
  window._cdInterval = setInterval(tick,1000);
}
