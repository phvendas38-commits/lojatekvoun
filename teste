    panel.innerHTML = `
      <div class="pix-box">
        <div class="qr-mock"></div>
        <p style="font-size:13px;color:var(--muted)">Escaneie o QR Code com o app do seu banco</p>
        <div class="code-copy"><input readonly value="00020126TEKVOUN-DEMO-PIX-${Date.now().toString().slice(-8)}52040000530398654${total.toFixed(2)}5802BR"><button class="btn btn-sm btn-ghost" id="copyPix">Copiar</button></div>
      </div>
      <div class="notice warn">⚠️ Demonstração: este QR Code e código "copia e cola" são ilustrativos. Para PIX real é necessário integrar um gateway de pagamento (ex.: Mercado Pago, PagSeguro, Efí).</div>`;
    document.getElementById('copyPix')?.addEventListener('click', ()=>toast('Código copiado (simulação)'));
  } else if(checkoutPayMethod==='cartao'){
    const maxInst = 10;
    let options='';
    for(let i=1;i<=maxInst;i++){ options+=`<option value="${i}">${i}x de ${money(total/i)} sem juros</option>`; }
    panel.innerHTML = `
      <div class="form-grid">
