  document.querySelectorAll('[data-rmbrand]').forEach(el=>el.addEventListener('click', ()=>{ BRANDS.splice(parseInt(el.dataset.rmbrand),1); renderBrandListAdmin(); renderBrands(); }));
}
function renderOfferTable(){
  document.getElementById('offerTableBody').innerHTML = PRODUCTS.map(p=>`
    <tr>
      <td>${p.nome.slice(0,40)}</td>
      <td>${money(p.preco)}</td>
      <td><input data-op="${p.id}" type="number" step="0.01" value="${p.precoPromo||''}" placeholder="—" style="width:90px"></td>
      <td><input data-ob="${p.id}" type="checkbox" ${p.bestseller?'checked':''}></td>
    </tr>`).join('');
  document.querySelectorAll('[data-op]').forEach(inp=>inp.addEventListener('change', ()=>{
    const p = PRODUCTS.find(x=>x.id==inp.dataset.op);
    p.precoPromo = inp.value ? parseFloat(inp.value) : null;
    renderAll(); toast('Oferta atualizada');
  }));
  document.querySelectorAll('[data-ob]').forEach(inp=>inp.addEventListener('change', ()=>{
    const p = PRODUCTS.find(x=>x.id==inp.dataset.ob);
    p.bestseller = inp.checked;
    renderAll(); toast('Atualizado');
  }));
}
function renderCoupTable(){
  document.getElementById('coupTableBody').innerHTML = COUPONS.map((c,i)=>`
    <tr><td>${c.code}</td><td>${c.percent}%</td><td><button class="btn btn-sm" style="color:var(--sale)" data-rmcoup="${i}">Excluir</button></td></tr>`).join('');
  document.querySelectorAll('[data-rmcoup]').forEach(b=>b.addEventListener('click', ()=>{ COUPONS.splice(parseInt(b.dataset.rmcoup),1); renderCoupTable(); toast('Cupom excluído'); }));
