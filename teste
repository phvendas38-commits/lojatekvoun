/* ---------------- CARRINHO ---------------- */
function addToCart(id, qty){
  const existing = cart.find(c=>c.id===id);
  if(existing) existing.qty += qty; else cart.push({id, qty});
  updateCartCount();
}
function updateCartCount(){
  const count = cart.reduce((s,c)=>s+c.qty,0);
  const el = document.getElementById('cartCount');
  el.textContent = count; el.style.display = count>0?'flex':'none';
}
function cartSubtotal(){
  return cart.reduce((s,c)=>{
    const p = PRODUCTS.find(x=>x.id===c.id); if(!p) return s;
    const price = (p.precoPromo && p.precoPromo<p.preco) ? p.precoPromo : p.preco;
    return s + price*c.qty;
  },0);
}
function renderCart(){
  const subtotal = cartSubtotal();
  const discount = couponApplied ? subtotal*(couponApplied.percent/100) : 0;
  const total = Math.max(0, subtotal - discount + freteCalc);
  document.getElementById('cartEmpty').classList.toggle('hide', cart.length>0);
  document.getElementById('cartLayout').classList.toggle('hide', cart.length===0);
  if(cart.length===0) return;
  const list = document.getElementById('cartItemsList');
  list.innerHTML = cart.map(c=>{
    const p = PRODUCTS.find(x=>x.id===c.id); if(!p) return '';
    const price = (p.precoPromo && p.precoPromo<p.preco) ? p.precoPromo : p.preco;
    return `
    <div class="cart-item" data-cid="${p.id}">
      <div class="th">${iconFor(p.categoria)}</div>
      <div class="info">
        <b>${p.nome}</b>
        <div class="cat">${p.categoria[0]} · SKU ${p.sku}</div>
        <div class="qty-ctrl" style="margin-top:8px;width:fit-content">
          <button data-dec="${p.id}">−</button><input value="${c.qty}" readonly style="width:36px"><button data-inc="${p.id}">+</button>
        </div>
        <div class="remove-x" data-remove="${p.id}">Remover</div>
      </div>
      <div class="price">${money(price*c.qty)}</div>
    </div>`;
  }).join('');
  list.querySelectorAll('[data-inc]').forEach(b=>b.addEventListener('click',()=>{ const it=cart.find(c=>c.id==b.dataset.inc); it.qty++; updateCartCount(); renderCart(); }));
  list.querySelectorAll('[data-dec]').forEach(b=>b.addEventListener('click',()=>{ const it=cart.find(c=>c.id==b.dataset.dec); it.qty=Math.max(1,it.qty-1); updateCartCount(); renderCart(); }));
  list.querySelectorAll('[data-remove]').forEach(b=>b.addEventListener('click',()=>{ cart = cart.filter(c=>c.id!=b.dataset.remove); updateCartCount(); renderCart(); }));

  document.getElementById('sumSubtotal').textContent = money(subtotal);
  document.getElementById('sumDiscountRow').classList.toggle('hide', !couponApplied);
  if(couponApplied) document.getElementById('sumDiscount').textContent = '- '+money(discount);
  document.getElementById('sumFrete').textContent = freteCalc>0 ? money(freteCalc) : 'Calcular abaixo';
  document.getElementById('sumTotal').textContent = money(total);
}
document.getElementById('applyCoupon').addEventListener('click', ()=>{
  const code = document.getElementById('couponInput').value.trim().toUpperCase();
  const found = COUPONS.find(c=>c.code===code);
  if(found){ couponApplied = found; toast('Cupom aplicado: '+found.percent+'% de desconto'); }
  else { couponApplied=null; toast('Cupom inválido'); }
  renderCart();
});
document.getElementById('calcFrete').addEventListener('click', ()=>{
  const cep = document.getElementById('cepInput').value.trim();
  if(cep.length<8){ toast('Digite um CEP válido'); return; }
  // Simulação de frete — não representa integração real com transportadora.
  const base = 19.90 + (parseInt(cep[0])||0)*1.4;
  freteCalc = Math.round(base*100)/100;
  toast('Frete estimado (simulação): '+money(freteCalc));
  renderCart();
});
document.getElementById('goCheckout').addEventListener('click', ()=>{
  if(cart.length===0){ toast('Seu carrinho está vazio'); return; }
  navTo('checkout'); renderCheckout();
});

/* ---------------- CHECKOUT ---------------- */
function renderCheckout(){
  document.getElementById('checkoutForm').classList.remove('hide');
  document.getElementById('checkoutSuccess').classList.add('hide');
  const subtotal = cartSubtotal();
  const discount = couponApplied ? subtotal*(couponApplied.percent/100) : 0;
  const total = Math.max(0, subtotal - discount + freteCalc);
  document.getElementById('checkoutSummaryItems').innerHTML = cart.map(c=>{
    const p = PRODUCTS.find(x=>x.id===c.id); if(!p) return '';
    const price = (p.precoPromo && p.precoPromo<p.preco) ? p.precoPromo : p.preco;
    return `<div class="summary-row"><span>${c.qty}x ${p.nome.slice(0,26)}${p.nome.length>26?'…':''}</span><b>${money(price*c.qty)}</b></div>`;
  }).join('');
  document.getElementById('chSubtotal').textContent = money(subtotal-discount);
  document.getElementById('chFrete').textContent = freteCalc>0?money(freteCalc):'A calcular';
  document.getElementById('chTotal').textContent = money(total);
  renderPayPanel();
}
document.querySelectorAll('.pay-tab').forEach(tab=>{
  tab.addEventListener('click', ()=>{
    document.querySelectorAll('.pay-tab').forEach(t=>t.classList.remove('active'));
