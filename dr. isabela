            <div><label className="gi-text-soft" style={fieldLabelStyle}>Abortos (A)</label><input type="number" min="0" className="gi-input" style={inputStyle} value={form.abortos} onChange={(e) => update("abortos", e.target.value)} /></div>
          </div>

          <div className="gi-primary" style={sectionTitle}><HeartPulse size={13} /> Antecedentes e uso de medicamentos</div>
          <div><label className="gi-text-soft" style={fieldLabelStyle}>Histórico sexual (quando pertinente)</label><input className="gi-input" style={inputStyle} value={form.historicoSexual} onChange={(e) => update("historicoSexual", e.target.value)} placeholder="Opcional" /></div>
          <div><label className="gi-text-soft" style={fieldLabelStyle}>Antecedentes pessoais</label><textarea className="gi-input" style={taStyle} value={form.antecedentesPessoais} onChange={(e) => update("antecedentesPessoais", e.target.value)} /></div>
          <div style={{ display: "grid", gridTemplateColumns: "1fr 1fr", gap: 12 }}>
            <div><label className="gi-text-soft" style={fieldLabelStyle}>Alergias</label><input className="gi-input" style={inputStyle} value={form.alergias} onChange={(e) => update("alergias", e.target.value)} /></div>
            <div><label className="gi-text-soft" style={fieldLabelStyle}>Medicamentos em uso</label><input className="gi-input" style={inputStyle} value={form.medicamentos} onChange={(e) => update("medicamentos", e.target.value)} /></div>
          </div>

          <div className="gi-primary" style={sectionTitle}><Stethoscope size={13} /> Exame clínico</div>
          <div><label className="gi-text-soft" style={fieldLabelStyle}>Exame físico</label><textarea className="gi-input" style={taStyle} value={form.exameFisico} onChange={(e) => update("exameFisico", e.target.value)} /></div>
          <div><label className="gi-text-soft" style={fieldLabelStyle}>Sinais vitais</label><input className="gi-input" style={inputStyle} value={form.sinaisVitais} onChange={(e) => update("sinaisVitais", e.target.value)} placeholder="PA, FC, peso..." /></div>

          <div className="gi-primary" style={sectionTitle}><FileText size={13} /> Diagnóstico e conduta</div>
          <div><label className="gi-text-soft" style={fieldLabelStyle}>Diagnósticos</label><textarea className="gi-input" style={taStyle} value={form.diagnosticos} onChange={(e) => update("diagnosticos", e.target.value)} /></div>
          <div><label className="gi-text-soft" style={fieldLabelStyle}>Evolução clínica</label><textarea className="gi-input" style={taStyle} value={form.evolucaoClinica} onChange={(e) => update("evolucaoClinica", e.target.value)} /></div>
          <div><label className="gi-text-soft" style={fieldLabelStyle}>Conduta médica</label><textarea className="gi-input" style={taStyle} value={form.condutaMedica} onChange={(e) => update("condutaMedica", e.target.value)} /></div>
          <div><label className="gi-text-soft" style={fieldLabelStyle}>Histórico de procedimentos</label><textarea className="gi-input" style={taStyle} value={form.historicoProcedimentos} onChange={(e) => update("historicoProcedimentos", e.target.value)} /></div>
          <div><label className="gi-text-soft" style={fieldLabelStyle}>Observações</label><textarea className="gi-input" style={taStyle} value={form.observacoes} onChange={(e) => update("observacoes", e.target.value)} /></div>

          <div style={{ display: "flex", gap: 10, marginTop: 4 }}>
            <button type="button" onClick={onClose} className="gi-btn-ghost" style={{ flex: 1, padding: 11, borderRadius: 10, fontSize: "0.86rem" }}>Cancelar</button>
            <button type="submit" className="gi-btn-primary" style={{ flex: 2, padding: 11, borderRadius: 10, fontSize: "0.86rem" }}>{isEdit ? "Salvar alterações" : "Salvar registro"}</button>
          </div>
        </form>
      </div>
    </div>
  );
}

function RecordsPage({ patients, records, onSave }) {
  const [query, setQuery] = useState("");
  const filtered = records.filter((r) => r.patientName.toLowerCase().includes(query.trim().toLowerCase())).sort((a, b) => b.date.localeCompare(a.date));

  return (
    <div className="gi-fade-in" style={{ display: "flex", flexDirection: "column", gap: 16 }}>
      <div style={{ position: "relative", maxWidth: 340 }}>
        <Search size={15} className="gi-text-faint" style={{ position: "absolute", left: 12, top: "50%", transform: "translateY(-50%)" }} />
        <input className="gi-input" placeholder="Pesquisar por paciente..." value={query} onChange={(e) => setQuery(e.target.value)} style={{ width: "100%", padding: "9px 12px 9px 34px", borderRadius: 9, fontSize: "0.84rem" }} />
      </div>
      <div style={{ display: "flex", flexDirection: "column", gap: 10 }}>
        {filtered.length === 0 && <div className="gi-text-faint" style={{ fontSize: "0.84rem" }}>Nenhum registro encontrado. Abra uma paciente e acesse a aba "Prontuário" para criar o primeiro registro.</div>}
        {filtered.map((r) => (
          <div key={r.id} className="gi-panel" style={{ borderRadius: 14, padding: 16 }}>
            <div style={{ display: "flex", justifyContent: "space-between", marginBottom: 6 }}>
              <div className="gi-text" style={{ fontWeight: 700, fontSize: "0.9rem" }}>{r.patientName}</div>
              <div className="gi-text-faint" style={{ fontSize: "0.76rem" }}>{fmtDateLong(r.date)}</div>
            </div>
            <div className="gi-text-soft" style={{ fontSize: "0.82rem" }}><strong>Diagnóstico:</strong> {r.diagnosticos || "—"}</div>
            <div className="gi-text-soft" style={{ fontSize: "0.82rem" }}><strong>Conduta:</strong> {r.condutaMedica || "—"}</div>
          </div>
        ))}
      </div>
    </div>
  );
}

/* ============================= APP ROOT ============================= */

export default function GinecoIsabelaApp() {
  const [theme, setTheme] = useState("light");
  const [authed, setAuthed] = useState(false);
  const [userEmail, setUserEmail] = useState("");
  const [role, setRole] = useState("Médica");
  const [active, setActive] = useState("dashboard");
  const [patients, setPatients] = useState([]);
  const [appointments, setAppointments] = useState([]);
  const [records, setRecords] = useState([]);
  const [ready, setReady] = useState(false);
  const [recordModal, setRecordModal] = useState(null); // { editing, defaultPatientId } | null

  useEffect(() => {
    (async () => {
      const t = await loadJSON("gineco:theme", "light");
      setTheme(t);
      const p = await loadJSON("gineco:patients", null);
      const a = await loadJSON("gineco:appointments", null);
      const rc = await loadJSON("gineco:records", null);
      const finalPatients = p || seedPatients();
      const finalAppts = a || seedAppointments();
      const finalRecords = rc || seedRecords();
      setPatients(finalPatients); setAppointments(finalAppts); setRecords(finalRecords);
      if (!p) saveJSON("gineco:patients", finalPatients);
      if (!a) saveJSON("gineco:appointments", finalAppts);
      if (!rc) saveJSON("gineco:records", finalRecords);
      setReady(true);
    })();
  }, []);

  useEffect(() => { if (ready) saveJSON("gineco:theme", theme); }, [theme, ready]);
  useEffect(() => { if (ready) saveJSON("gineco:patients", patients); }, [patients, ready]);
  useEffect(() => { if (ready) saveJSON("gineco:appointments", appointments); }, [appointments, ready]);
  useEffect(() => { if (ready) saveJSON("gineco:records", records); }, [records, ready]);

  function toggleTheme() { setTheme((t) => (t === "dark" ? "light" : "dark")); }

  function quickAddPatient(name) {
    const p = { id: `pt${Date.now()}`, name, cpf: "", birthDate: "", phone: "", whatsapp: "", email: "", address: "", emergencyContact: "", alergias: "", medicamentos: "", antecedentesFamiliares: "", archived: false };
    setPatients((prev) => [...prev, p]);
    return p;
  }
  function savePatient(patient) {
    setPatients((prev) => prev.some((p) => p.id === patient.id) ? prev.map((p) => p.id === patient.id ? patient : p) : [...prev, patient]);
  }
  function archivePatient(patient) {
    setPatients((prev) => prev.map((p) => p.id === patient.id ? { ...p, archived: !p.archived } : p));
  }
  function saveRecord(rc) {
    setRecords((prev) => prev.some((r) => r.id === rc.id) ? prev.map((r) => r.id === rc.id ? rc : r) : [...prev, rc]);
  }

  if (!ready) {
    return (
      <div className="gi-root theme-light gi-bg" style={{ minHeight: "100vh", display: "flex", alignItems: "center", justifyContent: "center" }}>
        <ThemeStyles />
        <div className="gi-text-soft" style={{ fontSize: "0.9rem" }}>Carregando sistema…</div>
      </div>
    );
  }

  if (!authed) {
    return <LoginScreen theme={theme} toggleTheme={toggleTheme} onLogin={({ email, role }) => { setUserEmail(email); setRole(role); setAuthed(true); }} />;
  }

  const canSeeProntuario = ROLE_PERMISSIONS[role]?.prontuario !== "none";
  const activePatients = patients.filter((p) => !p.archived);

  return (
    <Shell theme={theme} toggleTheme={toggleTheme} active={active} setActive={setActive} role={role} onLogout={() => setAuthed(false)} userEmail={userEmail}>
      {active === "dashboard" && <Dashboard patients={patients} appointments={appointments} userEmail={userEmail} role={role} setActive={setActive} />}
      {active === "agenda" && <Agenda patients={activePatients} appointments={appointments} setAppointments={setAppointments} quickAddPatient={quickAddPatient} />}
      {active === "pacientes" && (
        <PatientsPage
          patients={patients} appointments={appointments} records={records} role={role}
          onSave={savePatient} onArchive={archivePatient}
          onOpenRecord={(r, patientId) => setRecordModal({ editing: r, defaultPatientId: patientId })}
        />
      )}
      {active === "prontuarios" && (
        canSeeProntuario
          ? <RecordsPage patients={activePatients} records={records} onSave={saveRecord} />
          : <RestrictedView moduleLabel="O módulo de Prontuário" />
      )}

      {recordModal && (
        <RecordModal
          initial={recordModal.editing} defaultPatientId={recordModal.defaultPatientId} patients={activePatients}
          onSave={(rc) => { saveRecord(rc); setRecordModal(null); }} onClose={() => setRecordModal(null)}
        />
      )}
    </Shell>
  );
}
