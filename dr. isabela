function DayColumn({ date, appointments, onOpen, compact }) {
  const dayAppts = appointments.filter((a) => a.date === date).sort((a, b) => a.time.localeCompare(b.time));
  const d = new Date(date + "T00:00:00");
  const isToday = date === toISODate(new Date());
  return (
    <div className="gi-panel" style={{ borderRadius: 12, padding: 10, minHeight: compact ? 120 : 200, display: "flex", flexDirection: "column", gap: 8 }}>
      <div style={{ display: "flex", alignItems: "baseline", justifyContent: "space-between" }}>
        <div className="gi-text-soft" style={{ fontSize: "0.68rem", fontWeight: 700, textTransform: "uppercase" }}>{WEEKDAY_LABELS[d.getDay()]}</div>
        <div className={isToday ? "gi-primary" : "gi-text"} style={{ fontSize: "0.92rem", fontWeight: isToday ? 800 : 600 }}>{d.getDate()}</div>
      </div>
      <div style={{ display: "flex", flexDirection: "column", gap: 6 }}>
        {dayAppts.length === 0 && <div className="gi-text-faint" style={{ fontSize: "0.7rem" }}>Sem agendamentos</div>}
        {dayAppts.map((a) => <AppointmentChip key={a.id} a={a} onClick={() => onOpen(a)} />)}
      </div>
    </div>
  );
}

function Agenda({ patients, appointments, setAppointments, quickAddPatient }) {
  const [view, setView] = useState("Dia");
  const [refDate, setRefDate] = useState(toISODate(new Date()));
  const [modalOpen, setModalOpen] = useState(false);
  const [editing, setEditing] = useState(null);

  function openNew() { setEditing(null); setModalOpen(true); }
  function openEdit(a) { setEditing(a); setModalOpen(true); }
  function handleSave(appt) {
    setAppointments((prev) => prev.some((a) => a.id === appt.id) ? prev.map((a) => a.id === appt.id ? appt : a) : [...prev, appt]);
    setModalOpen(false);
  }
  function shift(delta) {
    if (view === "Dia") setRefDate(addDays(refDate, delta));
    else if (view === "Semana") setRefDate(addDays(refDate, delta * 7));
    else { const d = new Date(refDate + "T00:00:00"); d.setMonth(d.getMonth() + delta); setRefDate(toISODate(d)); }
  }
  const weekDates = useMemo(() => { const start = startOfWeek(refDate); return [...Array(7)].map((_, i) => addDays(start, i)); }, [refDate]);
  const monthGrid = useMemo(() => {
    const d = new Date(refDate + "T00:00:00"); const year = d.getFullYear(), month = d.getMonth();
    const start = toISODate(new Date(year, month, 1));
    const startWeek = startOfWeek(start);
    return { cells: [...Array(42)].map((_, i) => addDays(startWeek, i)), year, month };
  }, [refDate]);

  return (
    <div className="gi-fade-in" style={{ display: "flex", flexDirection: "column", gap: 16 }}>
      <div style={{ display: "flex", alignItems: "center", justifyContent: "space-between", flexWrap: "wrap", gap: 12 }}>
        <div style={{ display: "flex", alignItems: "center", gap: 8 }}>
          <button onClick={() => shift(-1)} className="gi-btn-ghost" style={{ width: 34, height: 34, borderRadius: 9, display: "flex", alignItems: "center", justifyContent: "center" }}><ChevronLeft size={16} /></button>
          <button onClick={() => setRefDate(toISODate(new Date()))} className="gi-btn-ghost" style={{ padding: "8px 14px", borderRadius: 9, fontSize: "0.8rem", fontWeight: 600 }}>Hoje</button>
          <button onClick={() => shift(1)} className="gi-btn-ghost" style={{ width: 34, height: 34, borderRadius: 9, display: "flex", alignItems: "center", justifyContent: "center" }}><ChevronRight size={16} /></button>
          <div className="gi-text" style={{ fontWeight: 700, fontSize: "1rem", marginLeft: 6 }}>{view === "Mês" ? `${MONTH_LABELS[monthGrid.month]} ${monthGrid.year}` : fmtDateLong(refDate)}</div>
        </div>
        <div style={{ display: "flex", alignItems: "center", gap: 10 }}>
          <div className="gi-panel-2" style={{ display: "flex", borderRadius: 9, padding: 3, gap: 2 }}>
            {["Dia", "Semana", "Mês"].map((v) => (
              <button key={v} onClick={() => setView(v)} className={v === view ? "gi-btn-primary" : ""} style={{ padding: "6px 14px", borderRadius: 7, fontSize: "0.78rem", fontWeight: 600, border: "none", cursor: "pointer", background: v === view ? undefined : "transparent", color: v === view ? undefined : "var(--text-soft)" }}>{v}</button>
            ))}
          </div>
          <button onClick={openNew} className="gi-btn-primary" style={{ display: "flex", alignItems: "center", gap: 6, padding: "9px 16px", borderRadius: 9, fontSize: "0.82rem" }}><Plus size={15} /> Novo agendamento</button>
        </div>
      </div>

      {view === "Dia" && <div style={{ maxWidth: 420 }}><DayColumn date={refDate} appointments={appointments} onOpen={openEdit} /></div>}
      {view === "Semana" && <div style={{ display: "grid", gridTemplateColumns: "repeat(7, minmax(130px, 1fr))", gap: 10, overflowX: "auto" }}>{weekDates.map((d) => <DayColumn key={d} date={d} appointments={appointments} onOpen={openEdit} />)}</div>}
      {view === "Mês" && (
        <div>
          <div style={{ display: "grid", gridTemplateColumns: "repeat(7,1fr)", gap: 6, marginBottom: 6 }}>{WEEKDAY_LABELS.map((w) => <div key={w} className="gi-text-faint" style={{ textAlign: "center", fontSize: "0.7rem", fontWeight: 700 }}>{w}</div>)}</div>
          <div style={{ display: "grid", gridTemplateColumns: "repeat(7,1fr)", gap: 6 }}>
            {monthGrid.cells.map((date) => {
              const inMonth = isSameMonth(date, monthGrid.year, monthGrid.month);
              const dayAppts = appointments.filter((a) => a.date === date);
              const isToday = date === toISODate(new Date());
              const d = new Date(date + "T00:00:00");
              return (
                <button key={date} onClick={() => { setRefDate(date); setView("Dia"); }} className="gi-panel" style={{ borderRadius: 10, padding: 8, minHeight: 62, textAlign: "left", cursor: "pointer", opacity: inMonth ? 1 : 0.35, display: "flex", flexDirection: "column", gap: 6 }}>
                  <div className={isToday ? "gi-primary" : "gi-text"} style={{ fontSize: "0.78rem", fontWeight: isToday ? 800 : 600 }}>{d.getDate()}</div>
                  {dayAppts.length > 0 && <div style={{ display: "flex", gap: 3, flexWrap: "wrap" }}>{dayAppts.slice(0, 4).map((a) => <div key={a.id} style={{ width: 6, height: 6, borderRadius: 999, background: STATUS_STYLE[a.status].dot }} />)}</div>}
                </button>
              );
            })}
          </div>
        </div>
      )}

      {modalOpen && <AppointmentModal initial={editing} patients={patients} appointments={appointments} onSave={handleSave} onClose={() => setModalOpen(false)} onQuickAddPatient={quickAddPatient} />}
    </div>
  );
}

