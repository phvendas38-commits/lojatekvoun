/* ============================= HELPERS ============================= */

function pad(n) { return String(n).padStart(2, "0"); }
function toISODate(d) { return `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}`; }
function toMinutes(hhmm) { const [h, m] = hhmm.split(":").map(Number); return h * 60 + m; }
function fmtDateLong(iso) {
  const d = new Date(iso + "T00:00:00");
  return `${WEEKDAY_LABELS[d.getDay()]}, ${d.getDate()} de ${MONTH_LABELS[d.getMonth()]}`;
}
function fmtDateShort(iso) {
  if (!iso) return "—";
  const d = new Date(iso + "T00:00:00");
  return `${pad(d.getDate())}/${pad(d.getMonth() + 1)}/${d.getFullYear()}`;
}
function addDays(iso, n) {
  const d = new Date(iso + "T00:00:00");
  d.setDate(d.getDate() + n);
  return toISODate(d);
}
function startOfWeek(iso) {
  const d = new Date(iso + "T00:00:00");
  d.setDate(d.getDate() - d.getDay());
  return toISODate(d);
}
function isSameMonth(iso, year, month) {
  const d = new Date(iso + "T00:00:00");
  return d.getFullYear() === year && d.getMonth() === month;
}
function overlaps(startA, durA, startB, durB) {
  const aStart = toMinutes(startA), aEnd = aStart + durA;
  const bStart = toMinutes(startB), bEnd = bStart + durB;
  return aStart < bEnd && bStart < aEnd;
}
function calcAge(birthDate) {
  if (!birthDate) return null;
  const b = new Date(birthDate + "T00:00:00");
  const now = new Date();
  let age = now.getFullYear() - b.getFullYear();
  const m = now.getMonth() - b.getMonth();
  if (m < 0 || (m === 0 && now.getDate() < b.getDate())) age--;
  return age;
}
function daysSince(iso) {
  if (!iso) return null;
  const a = new Date(iso + "T00:00:00");
  const b = new Date();
  return Math.floor((b - a) / 86400000);
}

