/* ============================= AI-STYLE SUMMARY (rule-based) ============================= */

function buildSmartSummary(patient, records) {
  if (!patient) return null;
  const sorted = [...records].sort((a, b) => b.date.localeCompare(a.date));
  const last = sorted[0];
  const missing = [];
  const lines = [];

  const age = calcAge(patient.birthDate);
  lines.push(`${patient.name}${age != null ? `, ${age} anos` : ""}.`);

  if (last) {
    lines.push(`Última consulta em ${fmtDateLong(last.date)} — queixa: ${last.queixaPrincipal || "não registrada"}.`);
    if (last.dum) lines.push(`DUM: ${fmtDateShort(last.dum)}${daysSince(last.dum) != null ? ` (${daysSince(last.dum)} dias atrás)` : ""}.`);
    const g = last.gestacoes ?? 0, p = last.partos ?? 0, a = last.abortos ?? 0;
    lines.push(`Histórico obstétrico: G${g}P${p}A${a}.`);
    if (last.diagnosticos) lines.push(`Diagnóstico mais recente: ${last.diagnosticos}`);
    if (last.condutaMedica) lines.push(`Conduta: ${last.condutaMedica}`);
  } else {
    lines.push("Nenhum registro de prontuário ainda — esta será a primeira consulta documentada.");
  }

  const alergias = last?.alergias || patient.alergias;
  if (alergias && alergias.toLowerCase() !== "nenhuma conhecida" && alergias.trim() !== "") {
    lines.push(`⚠ Alergia registrada: ${alergias}.`);
  }
  if (patient.antecedentesFamiliares) lines.push(`Antecedentes familiares: ${patient.antecedentesFamiliares}`);

  if (!patient.cpf) missing.push("CPF");
  if (!patient.alergias) missing.push("Alergias (cadastro)");
  if (!last) missing.push("Nenhuma avaliação clínica registrada ainda");
  else {
    if (!last.dum) missing.push("Data da última menstruação");
    if (!last.sinaisVitais) missing.push("Sinais vitais");
    if (!last.condutaMedica) missing.push("Conduta médica");
  }

  return { text: lines.join(" "), missing };
}

