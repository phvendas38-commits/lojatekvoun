function AppointmentModal({ initial, patients, appointments, onSave, onClose, onQuickAddPatient }) {
  const isEdit = !!initial?.id;
  const [form, setForm] = useState(() => initial || { patientId: patients[0]?.id || "", date: toISODate(new Date()), time: "09:00", type: APPT_TYPES[0], duration: 30, status: "Agendado", notes: "" });
  const [newPatientName, setNewPatientName] = useState("");
  const [showNewPatient, setShowNewPatient] = useState(false);

  const conflict = useMemo(() => appointments.find((a) => a.id !== form.id && a.date === form.date && a.status !== "Cancelada" && overlaps(a.time, a.duration, form.time, Number(form.duration))), [appointments, form]);

  function update(field, value) { setForm((f) => ({ ...f, [field]: value })); }
  function handleSubmit(e) {
    e.preventDefault();
    if (conflict) return;
    const patient = patients.find((p) => p.id === form.patientId);
    onSave({ ...form, id: form.id || `a${Date.now()}`, patientName: patient?.name || form.patientName, duration: Number(form.duration) });
  }
  function handleAddPatient() {
    if (!newPatientName.trim()) return;
    const p = onQuickAddPatient(newPatientName.trim());
    update("patientId", p.id);
    setNewPatientName(""); setShowNewPatient(false);
  }

  const fieldLabelStyle = { fontSize: "0.72rem", fontWeight: 600, letterSpacing: "0.03em", textTransform: "uppercase" };
  const inputStyle = { width: "100%", padding: "10px 11px", borderRadius: 9, fontSize: "0.86rem", marginTop: 5 };

  return (
    <div style={{ position: "fixed", inset: 0, background: "rgba(0,0,0,0.5)", zIndex: 50, display: "flex", alignItems: "center", justifyContent: "center", padding: 16 }}>
      <div className="gi-panel gi-fade-in gi-scroll" style={{ width: "100%", maxWidth: 460, borderRadius: 18, padding: 22, maxHeight: "92vh", overflowY: "auto" }}>
        <div style={{ display: "flex", alignItems: "center", justifyContent: "space-between", marginBottom: 18 }}>
          <div className="gi-text" style={{ fontSize: "1.05rem", fontWeight: 700 }}>{isEdit ? "Editar agendamento" : "Novo agendamento"}</div>
          <button onClick={onClose} className="gi-btn-ghost" style={{ width: 30, height: 30, borderRadius: 999, display: "flex", alignItems: "center", justifyContent: "center" }}><X size={15} /></button>
        </div>
        <form onSubmit={handleSubmit} style={{ display: "flex", flexDirection: "column", gap: 14 }}>
          <div>
            <label className="gi-text-soft" style={fieldLabelStyle}>Paciente</label>
            {!showNewPatient ? (
              <div style={{ display: "flex", gap: 8, marginTop: 5 }}>
                <select className="gi-input" style={{ ...inputStyle, margin: 0, flex: 1 }} value={form.patientId} onChange={(e) => update("patientId", e.target.value)}>
                  {patients.map((p) => <option key={p.id} value={p.id}>{p.name}</option>)}
                </select>
                <button type="button" onClick={() => setShowNewPatient(true)} className="gi-btn-ghost" style={{ padding: "0 12px", borderRadius: 9, fontSize: "0.78rem", whiteSpace: "nowrap" }}>+ Novo</button>
              </div>
            ) : (
              <div style={{ display: "flex", gap: 8, marginTop: 5 }}>
                <input className="gi-input" style={{ ...inputStyle, margin: 0, flex: 1 }} placeholder="Nome da nova paciente" value={newPatientName} onChange={(e) => setNewPatientName(e.target.value)} />
                <button type="button" onClick={handleAddPatient} className="gi-btn-primary" style={{ padding: "0 14px", borderRadius: 9, fontSize: "0.78rem" }}>Adicionar</button>
              </div>
            )}
          </div>
          <div style={{ display: "grid", gridTemplateColumns: "1fr 1fr", gap: 12 }}>
            <div><label className="gi-text-soft" style={fieldLabelStyle}>Data</label><input type="date" className="gi-input" style={inputStyle} value={form.date} onChange={(e) => update("date", e.target.value)} /></div>
            <div><label className="gi-text-soft" style={fieldLabelStyle}>Horário</label><input type="time" className="gi-input" style={inputStyle} value={form.time} onChange={(e) => update("time", e.target.value)} /></div>
          </div>
          <div>
            <label className="gi-text-soft" style={fieldLabelStyle}>Tipo de atendimento</label>
            <select className="gi-input" style={inputStyle} value={form.type} onChange={(e) => update("type", e.target.value)}>{APPT_TYPES.map((t) => <option key={t} value={t}>{t}</option>)}</select>
          </div>
          <div style={{ display: "grid", gridTemplateColumns: "1fr 1fr", gap: 12 }}>
            <div><label className="gi-text-soft" style={fieldLabelStyle}>Duração</label><select className="gi-input" style={inputStyle} value={form.duration} onChange={(e) => update("duration", e.target.value)}>{DURATIONS.map((d) => <option key={d} value={d}>{d} min</option>)}</select></div>
            <div><label className="gi-text-soft" style={fieldLabelStyle}>Status</label><select className="gi-input" style={inputStyle} value={form.status} onChange={(e) => update("status", e.target.value)}>{STATUSES.map((s) => <option key={s} value={s}>{s}</option>)}</select></div>
          </div>
          <div><label className="gi-text-soft" style={fieldLabelStyle}>Observações</label><textarea className="gi-input" style={{ ...inputStyle, resize: "vertical", minHeight: 56 }} value={form.notes} onChange={(e) => update("notes", e.target.value)} /></div>

          {conflict && (
            <div style={{ display: "flex", gap: 8, alignItems: "flex-start", padding: "10px 12px", borderRadius: 10, background: "rgba(220,38,38,0.1)", color: "#dc2626", fontSize: "0.8rem" }}>
              <AlertTriangle size={15} style={{ flex: "none", marginTop: 1 }} />
              <span>Conflito de horário: já existe consulta das {conflict.time} com {conflict.patientName} nesse intervalo.</span>
            </div>
          )}

          <div style={{ display: "flex", gap: 10, marginTop: 4 }}>
            <button type="button" onClick={onClose} className="gi-btn-ghost" style={{ flex: 1, padding: 11, borderRadius: 10, fontSize: "0.86rem" }}>Cancelar</button>
            <button type="submit" disabled={!!conflict} className="gi-btn-primary" style={{ flex: 2, padding: 11, borderRadius: 10, fontSize: "0.86rem" }}>{isEdit ? "Salvar alterações" : "Criar agendamento"}</button>
          </div>
        </form>
      </div>
    </div>
  );
}

