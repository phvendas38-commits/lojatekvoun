function PatientsPage({ patients, appointments, records, role, onSave, onArchive, onOpenRecord }) {
  const [query, setQuery] = useState("");
  const [selectedId, setSelectedId] = useState(null);
  const [modalOpen, setModalOpen] = useState(false);
  const [editing, setEditing] = useState(null);
  const [showArchived, setShowArchived] = useState(false);
  const canSeeProntuario = ROLE_PERMISSIONS[role]?.prontuario !== "none";

  const filtered = patients.filter((p) => {
    if (p.archived && !showArchived) return false;
    const q = query.trim().toLowerCase();
    if (!q) return true;
    return p.name.toLowerCase().includes(q) || (p.phone || "").includes(q) || (p.cpf || "").includes(q);
  });
  const selected = patients.find((p) => p.id === selectedId);

  if (selected) {
    return (
      <PatientProfile
        patient={selected} appointments={appointments} records={records} canSeeProntuario={canSeeProntuario}
        onBack={() => setSelectedId(null)} onEdit={(p) => { setEditing(p); setModalOpen(true); }} onArchive={onArchive}
        onOpenRecord={(r, patientId) => onOpenRecord(r, patientId || selected.id)}
      />
    );
  }

  return (
    <div className="gi-fade-in" style={{ display: "flex", flexDirection: "column", gap: 16 }}>
      <div style={{ display: "flex", alignItems: "center", justifyContent: "space-between", flexWrap: "wrap", gap: 12 }}>
        <div style={{ position: "relative", flex: 1, minWidth: 220, maxWidth: 340 }}>
          <Search size={15} className="gi-text-faint" style={{ position: "absolute", left: 12, top: "50%", transform: "translateY(-50%)" }} />
          <input className="gi-input" placeholder="Pesquisar por nome, telefone ou CPF..." value={query} onChange={(e) => setQuery(e.target.value)} style={{ width: "100%", padding: "9px 12px 9px 34px", borderRadius: 9, fontSize: "0.84rem" }} />
        </div>
        <div style={{ display: "flex", gap: 10 }}>
          <label className="gi-text-soft" style={{ display: "flex", alignItems: "center", gap: 6, fontSize: "0.78rem", cursor: "pointer" }}><input type="checkbox" checked={showArchived} onChange={(e) => setShowArchived(e.target.checked)} /> Mostrar arquivadas</label>
          <button onClick={() => { setEditing(null); setModalOpen(true); }} className="gi-btn-primary" style={{ display: "flex", alignItems: "center", gap: 6, padding: "9px 16px", borderRadius: 9, fontSize: "0.82rem" }}><Plus size={15} /> Nova paciente</button>
        </div>
      </div>

      <div style={{ display: "grid", gridTemplateColumns: "repeat(auto-fill, minmax(240px, 1fr))", gap: 12 }}>
        {filtered.length === 0 && <div className="gi-text-faint" style={{ fontSize: "0.84rem" }}>Nenhuma paciente encontrada.</div>}
        {filtered.map((p) => (
          <button key={p.id} onClick={() => setSelectedId(p.id)} className="gi-panel" style={{ textAlign: "left", cursor: "pointer", borderRadius: 14, padding: 16, display: "flex", gap: 12, alignItems: "center" }}>
            <div style={{ width: 40, height: 40, borderRadius: 999, flex: "none", background: "var(--primary)", display: "flex", alignItems: "center", justifyContent: "center", color: "#fff", fontWeight: 800, fontSize: "0.86rem" }}>
              {p.name.split(" ").map((n) => n[0]).slice(0, 2).join("")}
            </div>
            <div style={{ minWidth: 0 }}>
              <div className="gi-text" style={{ fontWeight: 700, fontSize: "0.88rem", overflow: "hidden", textOverflow: "ellipsis", whiteSpace: "nowrap" }}>{p.name}{p.archived ? " (arquivada)" : ""}</div>
              <div className="gi-text-faint" style={{ fontSize: "0.74rem" }}>{p.phone || "Sem telefone"}</div>
            </div>
          </button>
        ))}
      </div>

      {modalOpen && <PatientFormModal initial={editing} onSave={(p) => { onSave(p); setModalOpen(false); }} onClose={() => setModalOpen(false)} />}
    </div>
  );
}

