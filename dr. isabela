    const realized = appointments.filter((a) => a.status === "Realizada");
    const cancelled = appointments.filter((a) => a.status === "Cancelada");
    const faltas = appointments.filter((a) => a.status === "Faltou");
    const retornosPendentes = appointments.filter((a) => a.type === "Consulta de retorno" && a.date >= today && a.status !== "Cancelada");
    return { todays, scheduledCount: scheduled.length, realizedCount: realized.length, cancelledCount: cancelled.length, faltasCount: faltas.length, retornosCount: retornosPendentes.length };
